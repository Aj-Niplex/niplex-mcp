# NIPLEX-MCP environment — placeholder names ONLY. Never commit real values.
# Set the real values in the deployment's environment (Horizon env panel).

# Server auth (fail-secure middleware: without this every request returns 503)
MCP_API_KEY=

# GitHub
GITHUB_PAT=

# Sandboxes
DAYTONA_API_KEY=
E2B_API_KEY=
SANDBOX_TOKEN=
HORIZON_SANDBOX_URL=https://sandbox.fastmcp.app/mcp

# HidenCloud SFTP (Pterodactyl, file-only, path-confined)
HIDENCLOUD_SFTP_HOST=
HIDENCLOUD_SFTP_PORT=2022
HIDENCLOUD_SFTP_USER=
HIDENCLOUD_SFTP_PASSWORD=
# Seconds before a dead/unreachable SFTP host aborts (connect, banner, auth).
# Prevents tool calls from hanging for minutes on an unreachable server.
HIDENCLOUD_SFTP_TIMEOUT=15

# Google Workspace (per-account OAuth client + token JSON)
GOOGLE_PROFESSIONAL_CREDENTIALS_JSON=
GOOGLE_PROFESSIONAL_TOKEN_JSON=
GOOGLE_PERSONAL_CREDENTIALS_JSON=
GOOGLE_PERSONAL_TOKEN_JSON=

# YouTube
YOUTUBE_API_KEY=

# Neural-MCP (remote memory/sub-agent layer)
NEURAL_MCP_URL=
NEURAL_MCP_API_KEY=

# Optional caches/search
MDB_MCP_CONNECTION_STRING=
YOU_COM_API_KEY=
